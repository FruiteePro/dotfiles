#!/usr/bin/env zsh
### KILL BY PORT
# 选监听中的 TCP 端口并 kill 对应进程，可多选（tab）。默认 -9
# mnemonic: [K]ill [S]erver

setopt localoptions pipefail

local pids
pids=$(lsof -Pwni tcp |
  fzf --header-lines=1 -m --height=50% --header='[kill:tcp]' |
  awk '{print $2}' | sort -u)

if [[ -n $pids ]]; then
  echo $pids | xargs kill -${1:-9}
  echo "已 kill: $(echo $pids | tr '\n' ' ')"
fi
