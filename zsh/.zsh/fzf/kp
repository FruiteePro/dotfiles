#!/usr/bin/env zsh
### KILL PROCESS
# 选进程并 kill，可多选（tab）。默认 -9，可传信号: kp 15
# mnemonic: [K]ill [P]rocess

setopt localoptions pipefail

local pids
pids=$(ps -axo user,pid,ppid,stat,tty,command |
  awk -v self=$$ 'NR==1 || ($2 != self)' |
  fzf --header-lines=1 -m --height=50% --header='[kill:process]' |
  awk '{print $2}')

if [[ -n $pids ]]; then
  echo $pids | xargs kill -${1:-9}
  echo "已 kill: $(echo $pids | tr '\n' ' ')"
fi
