#!/usr/bin/env zsh
### BREW INSTALL
# 从全部 formula 中选并安装，可多选（tab）。
# mnemonic: [B]rew [I]nstall [P]ackage

setopt localoptions pipefail

local pkgs
pkgs=$(brew formulae |
  fzf -m --height=60% --header='[brew:install]' \
      --preview 'brew info {}') || return

if [[ -n $pkgs ]]; then
  echo $pkgs | tr '\n' ' ' | read -A list
  brew install $list
fi
