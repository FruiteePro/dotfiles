#!/usr/bin/env zsh
### BREW UPGRADE
# 从可升级的包中选并升级，可多选（tab）。
# mnemonic: [B]rew [U]pgrade [P]ackage

setopt localoptions pipefail

local outdated
outdated=$(brew outdated --quiet)

if [[ -z $outdated ]]; then
  echo "没有可升级的包。"
  return 0
fi

local pkgs
pkgs=$(echo $outdated |
  fzf -m --height=60% --header='[brew:upgrade]' \
      --preview 'brew info {}') || return

if [[ -n $pkgs ]]; then
  echo $pkgs | tr '\n' ' ' | read -A list
  brew upgrade $list
fi
