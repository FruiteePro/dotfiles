#!/usr/bin/env zsh
### PATH BROWSER
# 浏览 $PATH 中的目录，回车看里面的可执行文件。
# mnemonic: [F]ind [P]ath

setopt localoptions pipefail

local dir
dir=$(print -l ${(s.:.)PATH} | awk '!seen[$0]++' |
  fzf --height=50% --header='[find:path]' \
      --preview 'ls -1 {} 2>/dev/null | head -100') || return

if [[ -d $dir ]]; then
  print -l $dir/*(N.x:t) |
    fzf --height=50% --header="[find:exe] => $dir" >/dev/null
fi
