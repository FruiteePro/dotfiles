#!/usr/bin/env zsh
### UTILS
# 速查本机自定义命令与别名，回车执行选中项。

setopt localoptions pipefail

local helptxt="bip     [fzf:brew]     选包安装
bup     [fzf:brew]     选包升级
bcp     [fzf:brew]     选包卸载
fp      [fzf:path]     浏览 \$PATH 及其可执行文件
fps     [fzf:proc]     选进程输出 PID
kp      [fzf:proc]     选进程并 kill
ks      [fzf:port]     选 TCP 端口并 kill
fif     [fzf:grep]     按内容检索文件并打开
util    [fzf:help]     本清单
proxy   [net]          代理开关: proxy on|off|status
k       [alias]        kubectl
lg      [alias]        lazygit
tdk     [alias]        kubectl trip-dev
ttk     [alias]        kubectl trip-testing
tpk     [alias]        kubectl trip-prod"

local cmd
cmd=$(echo $helptxt |
  fzf --height=60% --header='[utils:show]' | awk '{print $1}') || return

if [[ -n $cmd ]]; then
  print -z $cmd
fi
