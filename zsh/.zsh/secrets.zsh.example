# 密钥模板。复制为 ~/.zsh/secrets.zsh 后填入真实值。
# 这个文件只提交模板，secrets.zsh 本体已在 .gitignore 中排除。
#
# 每个变量的用途 / 默认值 / 使用方见 ~/.agents/README.md（skill 仓库根 README）。

# Kiro 反代
export KIRO_ANTHROPIC_API_KEY=""

# Ada / Coding Plan
export CODING_PLAN_API_KEY=""
export BBZAI_MCP_TOKEN=""

# 本机 MCP OAuth proxy（127.0.0.1:8787）共享 bearer，dot-mcp / zeus-mcp 走它转发
export MCP_PROXY_SHARED_TOKEN=""

# ACS Agent Service（acs-agent-service.sys.ctripcorp.com /v1/run）bearer
export ACS_AGENT_TOKEN=""


# DOT 平台
export DOT_BEARER_TOKEN=""

# 飞书自建应用（lark-cli / feishu-doc-mcp）
export FEISHU_APP_ID=""
export FEISHU_APP_SECRET=""

# iData 平台会话 cookie，过期需重新抓取
export IDATA_COOKIE_SHA=""
export IDATA_COOKIE_SGP=""

# Kueue Manager 后端 API
export KUEUE_API_USER=""
export KUEUE_API_PASS=""

# Spark on ACS 后端 API
export SPARK_ACS_API_PASS=""

# 阿里云 ARMS Prometheus 端点：URL 内嵌访问凭证（/aliyun-prom-<token>），
# 拿到 URL 即可无鉴权读集群指标，因此只放这里，绝不写进代码。
# ack-prometheus / kueue-health-check 按 --env 取用；缺失会直接报错。
export ACK_PROM_ENDPOINT_PROD=""
export ACK_PROM_ENDPOINT_TEST=""
export ACK_PROM_ENDPOINT_PRESSURE=""

# DeepSeek
export DEEPSEEK_API_KEY=""

# 按需启用的 Anthropic 兼容端点
# export ANTHROPIC_BASE_URL=""
# export ANTHROPIC_AUTH_TOKEN=""
