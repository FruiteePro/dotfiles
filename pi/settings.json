{
  "$schema": "https://pi.dev/schemas/settings.json",
  "defaultProvider": "kiro-rs",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "externalEditor": "vim",
  "theme": "system",
  "tuiMode": "regular",
  "terminal": {
    "clearOnShrink": true
  },
  "packages": [
    "npm:@capyup/pi-auto-compact",
    "npm:pi-hashline-edit-pro",
    "npm:@narumitw/pi-subagents",
    "npm:@narumitw/pi-btw",
    "npm:@ff-labs/pi-fff",
    "npm:pi-workspace-history",
    "npm:@tmustier/pi-raw-paste",
    "npm:pi-add-dir",
    "npm:pi-cometix-footer",
    "npm:pi-plan",
    "npm:pi-prompt-view",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@cnife/pi-auto-naming-session@0.4.1",
    "npm:@injaneity/pi-computer-use@0.5.1"
  ],
  "skills": [
    "~/.codex/skills"
  ],
  "lastChangelogVersion": "1.5.0",
