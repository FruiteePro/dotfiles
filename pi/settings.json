  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-workspace-history\",\"scope\":\"user\"}": "0.5.2",
    "{\"source\":\"npm:@tmustier/pi-raw-paste\",\"scope\":\"user\"}": "0.1.3",
    "{\"source\":\"npm:@cnife/pi-auto-naming-session@0.4.1\",\"scope\":\"user\"}": "0.4.1"
  }
}